<Window x:Class="KankiVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:k="clr-namespace:KankiVPN"
        Title="{k:T 'Kanki VPN'}" Icon="pack://application:,,,/Assets/kanki.ico"
        Width="440" Height="740" MinWidth="380" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Vazir}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0" Margin="24,20,24,12" MaxWidth="560">
            <Image Source="pack://application:,,,/Assets/logo.png" Width="40" Height="40" DockPanel.Dock="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Button x:Name="LangBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" MinHeight="32"
                    Padding="12,2" FontSize="13" Click="Lang_Click" ToolTip="{k:T 'Language'}"/>
            <TextBlock Text="{k:T 'Kanki VPN'}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
        </DockPanel>

        <!-- the service is missing: the only thing that matters then -->
        <Border x:Name="ServiceBanner" Grid.Row="1" Margin="24,0,24,8" MaxWidth="560" Padding="12,10"
                CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Red}" Visibility="Collapsed">
            <TextBlock x:Name="ServiceText" FontSize="13" Foreground="{StaticResource Red}"/>
        </Border>

        <!-- tabs -->
        <Border x:Name="TabBar" Grid.Row="2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}">
            <UniformGrid Columns="4" Margin="16,0" MaxWidth="560">
                <RadioButton x:Name="TabHome" Style="{StaticResource Tab}" Content="{k:T 'Home'}" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabServers" Style="{StaticResource Tab}" Content="{k:T 'Servers'}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSettings" Style="{StaticResource Tab}" Content="{k:T 'Settings'}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabLog" Style="{StaticResource Tab}" Content="{k:T 'Log'}" Checked="Tab_Checked"/>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="3" MaxWidth="560" Margin="24,0">

            <!-- first run: the subscription -->
            <StackPanel x:Name="LoginPage" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,40">
                <TextBlock Text="{k:T 'Add your subscription'}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Style="{StaticResource Help}" FontSize="14" Margin="0,8,0,16"
                           Text="{k:T 'Paste the subscription link or code you got from Kanki.'}"/>
                <TextBox x:Name="SubInput" FlowDirection="LeftToRight" KeyDown="SubInput_KeyDown"
                         AutomationProperties.Name="{k:T 'Subscription link or code'}"/>
                <Button x:Name="AddSubBtn" Style="{StaticResource Primary}" Content="{k:T 'Add'}" Margin="0,12,0,0" Click="AddSub_Click"/>
                <TextBlock x:Name="LoginError" Foreground="{StaticResource Red}" FontSize="13" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- connect -->
            <Grid x:Name="HomePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StateText" Grid.Row="1" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,0,0,16"/>

                <Button x:Name="ConnectBtn" Grid.Row="2" Width="208" Height="208" Cursor="Hand"
                        HorizontalAlignment="Center" Click="Connect_Click" Focusable="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter/>
                                <Ellipse x:Name="focus" Stroke="{StaticResource Text}" StrokeThickness="1"
                                         StrokeDashArray="2 3" Margin="-6" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="focus" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <!-- the ring: grey = off, gold turning = connecting, green = on, red = failed -->
                        <Ellipse x:Name="Ring" StrokeThickness="6" Stroke="{StaticResource Line}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="RingTurn"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Margin="16" Fill="{StaticResource Surface}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="92" Height="92"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="ActionText" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" Foreground="{StaticResource Gold}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- the chosen server; opens the list -->
                <Button x:Name="ServerBtn" Grid.Row="3" Margin="0,24,0,0" Cursor="Hand" Click="ServerBtn_Click"
                        Foreground="{StaticResource Text}"
                        HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{StaticResource Surface}" CornerRadius="12" Padding="16,12"
                                    BorderThickness="1" BorderBrush="{StaticResource Line}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldDark}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <Border x:Name="CcBox" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20"
                                Background="{StaticResource Line}" Margin="0,0,12,0">
                            <TextBlock x:Name="CcText" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="›" FontSize="20" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ServerName" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <TextBlock x:Name="ServerTags" Style="{StaticResource Help}" FontSize="13"/>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{k:T 'Download'}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RxText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" FlowDirection="LeftToRight" Text="—"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Help}" Text="{k:T 'Upload'}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" FlowDirection="LeftToRight" Text="—"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Help}" Text="{k:T 'Time'}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TimeText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" FlowDirection="LeftToRight" Text="—"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="5" VerticalAlignment="Top" Margin="0,16,0,0">
                    <TextBlock x:Name="ProtectText" Style="{StaticResource Help}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="ErrorText" FontSize="13" Foreground="{StaticResource Red}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="NoticeText" FontSize="13" Foreground="{StaticResource Warn}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Row="6" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="0,12,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UserText" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="DaysText" Grid.Column="1" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DataText" Grid.Column="2" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- servers -->
            <DockPanel x:Name="ServersPage" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,16,0,8">
                    <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" MinHeight="36"
                            Content="{k:T 'Refresh servers'}" Click="Refresh_Click"/>
                    <TextBlock x:Name="ServersCount" Style="{StaticResource Help}" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="ServersEmpty" DockPanel.Dock="Top" Style="{StaticResource Help}" FontSize="14"
                           Margin="0,24" Visibility="Collapsed"
                           Text="{k:T 'No servers for Windows in this subscription. WireGuard or AmneziaWG must be on for you in the panel.'}"/>
                <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                         PreviewMouseLeftButtonUp="ServerList_Click" KeyDown="ServerList_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Padding="12,12" BorderThickness="0,0,0,1"
                                                BorderBrush="{StaticResource Line}" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type k:ServerItem}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18"
                                        Background="{StaticResource Line}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Cc}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                </Border>
                                <Ellipse DockPanel.Dock="Right" Width="10" Height="10" Fill="{StaticResource Green}"
                                         VerticalAlignment="Center" Visibility="{Binding CurrentVisibility}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding Tags}" Style="{StaticResource Help}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- settings: the save button stays at the bottom -->
            <DockPanel x:Name="SettingsPage" Visibility="Collapsed">
                <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="0,12,0,16">
                    <DockPanel>
                        <Button x:Name="SaveBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}"
                                Content="{k:T 'Save settings'}" Click="Save_Click"/>
                        <TextBlock x:Name="SaveMsg" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,16">
                        <TextBlock Style="{StaticResource GroupTitle}" Text="{k:T 'Protection'}"/>
                        <CheckBox x:Name="KillSwitchBox" Style="{StaticResource Switch}">
                            <StackPanel>
                                <TextBlock Text="{k:T 'Kill switch'}"/>
                                <TextBlock Style="{StaticResource Help}" Text="{k:T 'If the VPN drops, all internet stops until it is back. Nothing leaks outside the tunnel.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="Ipv6Box" Style="{StaticResource Switch}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{k:T 'Block IPv6 outside the VPN'}"/>
                                <TextBlock Style="{StaticResource Help}" Text="{k:T 'Stops IPv6 leaks on networks that have IPv6.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="LanBox" Style="{StaticResource Switch}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{k:T 'Allow local network'}"/>
                                <TextBlock Style="{StaticResource Help}" Text="{k:T 'Printers, file sharing and the router stay reachable.'}"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Style="{StaticResource Help}" Margin="0,12,0,0"
                                   Text="{k:T 'DNS leak protection is always on: DNS only goes to the VPN\'s DNS servers.'}"/>

                        <TextBlock Style="{StaticResource GroupTitle}" Text="{k:T 'Split tunneling'}"/>
                        <RadioButton x:Name="SplitAll" Style="{StaticResource Choice}" GroupName="split"
                                     Content="{k:T 'Everything through the VPN'}" Checked="Split_Checked"/>
                        <RadioButton x:Name="SplitExclude" Style="{StaticResource Choice}" GroupName="split"
                                     Content="{k:T 'Everything except these addresses'}" Checked="Split_Checked"/>
                        <RadioButton x:Name="SplitInclude" Style="{StaticResource Choice}" GroupName="split"
                                     Content="{k:T 'Only these addresses'}" Checked="Split_Checked"/>
                        <TextBox x:Name="SplitBox" FlowDirection="LeftToRight" AcceptsReturn="True" MinHeight="96"
                                 VerticalContentAlignment="Top" TextWrapping="NoWrap" Margin="0,8,0,0"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Style="{StaticResource Help}" Text="{k:T 'One IP or range per line, like 5.0.0.0/8'}"/>
                        <TextBlock x:Name="SplitNote" Style="{StaticResource Help}" Foreground="{StaticResource Warn}"
                                   Text="{k:T 'The kill switch does not apply when only some addresses use the VPN.'}"/>

                        <TextBlock Style="{StaticResource GroupTitle}" Text="{k:T 'Connection'}"/>
                        <TextBlock Text="{k:T 'DNS servers'}"/>
                        <TextBox x:Name="DnsBox" FlowDirection="LeftToRight" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Help}" Text="{k:T 'Empty = the server\'s own DNS'}"/>
                        <TextBlock Text="{k:T 'MTU'}" Margin="0,12,0,0"/>
                        <TextBox x:Name="MtuBox" FlowDirection="LeftToRight" Margin="0,6,0,0" Width="120" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Help}" Text="{k:T '0 = automatic'}"/>
                        <CheckBox x:Name="AutoBox" Style="{StaticResource Switch}" Margin="0,12,0,0"
                                  Content="{k:T 'Connect when the service starts'}"/>
                        <CheckBox x:Name="SignInBox" Style="{StaticResource Switch}" Margin="0,4,0,0"
                                  Content="{k:T 'Open at sign-in'}" Click="SignIn_Click"/>

                        <TextBlock Style="{StaticResource GroupTitle}" Text="{k:T 'Account'}"/>
                        <TextBlock x:Name="AccountText" FontSize="14"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource Ghost}" Content="{k:T 'Refresh servers'}" Click="Refresh_Click" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource Ghost}" Content="{k:T 'Sign out'}" Click="SignOut_Click" Margin="0,0,8,8"
                                    Foreground="{StaticResource Red}" BorderBrush="{StaticResource Red}"/>
                        </WrapPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Help}" Margin="0,16,0,0" FlowDirection="LeftToRight"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- log -->
            <DockPanel x:Name="LogPage" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,16,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" MinHeight="36" Content="{k:T 'Copy log'}" Click="CopyLog_Click"/>
                    <TextBlock x:Name="LogMsg" Style="{StaticResource Help}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="LogBox" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12"
                         TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,16"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
