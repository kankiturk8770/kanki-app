<Window x:Class="KankiVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:k="clr-namespace:KankiVPN"
        Title="Kanki VPN" Icon="pack://application:,,,/Assets/kanki.ico"
        Width="460" Height="880" MinWidth="420" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Vazir}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root">
        <!-- Ui.kt KankiBackground: black, a faint glow behind the connect button, twinkling stars -->
        <k:Backdrop x:Name="Backdrop"/>
        <Grid MaxWidth="560">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- top bar (HomeUi.kt AppHeader): the K shield and KANKI VPN on one side, the account button (the link
                 icon) on the other -->
            <DockPanel Grid.Row="0" Margin="16,8,16,4">
                <k:Logo3D DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,8,0"/>
                <Button x:Name="AccountBtn" DockPanel.Dock="Right" Style="{StaticResource Plain}" Width="36" Height="36"
                        Click="Account_Click" ToolTip="{k:T 'Account'}">
                    <k:Glass CornerRadius="12">
                        <k:KIcon Kind="link" Width="20" Height="20" Fill="{DynamicResource Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </k:Glass>
                </Button>
                <TextBlock Text="KANKI VPN" FontFamily="{StaticResource Brand}" FontSize="15"
                           Foreground="{DynamicResource Primary}" FlowDirection="LeftToRight" VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource CPrimary}" BlurRadius="9" ShadowDepth="0" Opacity="0.75"/>
                    </TextBlock.Effect>
                </TextBlock>
            </DockPanel>

            <Grid Grid.Row="1">
                <!-- the service is missing: the one thing that matters then -->
                <Border x:Name="ServiceBanner" VerticalAlignment="Top" Panel.ZIndex="5" Margin="16,0,16,0" Padding="12,10"
                        CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Danger}" Background="{DynamicResource Sheet}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ServiceText" FontSize="13" Foreground="{DynamicResource Danger}"/>
                </Border>

                <!-- ============================== first run: the subscription -->
                <Grid x:Name="LoginPage" Visibility="Collapsed" Margin="24,0">
                    <StackPanel VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="120" Height="120" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="KANKI VPN" FontFamily="{StaticResource Brand}" FontWeight="Bold" FontSize="26" Margin="0,12,0,0"
                                   Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{k:T 'Paste the subscription link or code you got from Kanki.'}" Style="{StaticResource Small}"
                                   FontSize="14" TextAlignment="Center" Margin="0,16,0,16"/>
                        <TextBox x:Name="SubInput" FlowDirection="LeftToRight" KeyDown="SubInput_KeyDown"
                                 AutomationProperties.Name="{k:T 'Subscription link or code'}"/>
                        <Button x:Name="AddSubBtn" Style="{StaticResource BigButton}" Content="{k:T 'Sign in'}" Margin="0,12,0,0" Click="AddSub_Click"/>
                        <TextBlock x:Name="LoginError" Foreground="{DynamicResource Danger}" FontSize="13" Margin="0,12,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ============================== Home (HomeUi.kt HomeContent): the map and the connect button share
                     what is left over the fixed cards (44 / 56) -->
                <Grid x:Name="HomePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="44*"/>
                        <RowDefinition Height="56*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- "your location : Iran"; connected: "your IP : Germany" -->
                    <k:Glass x:Name="LocChip" Grid.Row="0" Margin="16,0" HorizontalAlignment="Left" CornerRadius="99" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LocDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LocText" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}" TextWrapping="NoWrap"/>
                            <Ellipse x:Name="LocDot2" Width="4" Height="4" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </k:Glass>

                    <Grid x:Name="MapBox" Grid.Row="1" SizeChanged="HomeBoxes_SizeChanged">
                        <k:WorldMap x:Name="Map" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid x:Name="OrbBox" Grid.Row="2" SizeChanged="HomeBoxes_SizeChanged">
                        <k:Orb x:Name="ConnectBtn" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="True"
                               AutomationProperties.Name="{k:T 'Connect'}"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="16,8,16,8">
                        <!-- the server in use, only while connected (HomeUi.kt ConnectedCard) -->
                        <k:Glass x:Name="ServerCard" Selected="True" Height="44" Padding="12,0" Margin="0,0,0,8" Visibility="Collapsed">
                            <DockPanel>
                                <Image x:Name="CardFlag" DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border x:Name="StablePill" DockPanel.Dock="Right" CornerRadius="99" Padding="8,3" VerticalAlignment="Center" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StableDot" Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StableText" Text="{k:T 'Stable connection'}" FontSize="10" FontWeight="Bold" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CardName" FontSize="13" FontWeight="Black" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock x:Name="CardSub" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </DockPanel>
                        </k:Glass>

                        <!-- the three modes (ModesUi.kt ModeRow) -->
                        <UniformGrid Columns="3" Margin="-4,0">
                            <RadioButton x:Name="ModeSmart" Style="{StaticResource ModeTile}" Tag="ModeSmart" Checked="Mode_Checked">
                                <StackPanel>
                                    <k:KIcon x:Name="ModeSmartIcon" Kind="smart" Width="20" Height="20"/>
                                    <TextBlock x:Name="ModeSmartText" Text="{k:T 'Smart'}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeGame" Style="{StaticResource ModeTile}" Tag="ModeGame" Checked="Mode_Checked">
                                <StackPanel>
                                    <k:KIcon x:Name="ModeGameIcon" Kind="game" Width="20" Height="20"/>
                                    <TextBlock x:Name="ModeGameText" Text="{k:T 'Gaming'}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeAnti" Style="{StaticResource ModeTile}" Tag="ModeAnti" Checked="Mode_Checked">
                                <StackPanel>
                                    <k:KIcon x:Name="ModeAntiIcon" Kind="anti" Width="20" Height="20"/>
                                    <TextBlock x:Name="ModeAntiText" Text="{k:T 'Anti-filter'}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <!-- what the chosen mode does (ModesUi.kt ModeHint) -->
                        <k:Glass CornerRadius="12" Padding="12,8" Margin="0,8,0,0">
                            <DockPanel>
                                <k:KIcon x:Name="ModeHintIcon" Kind="spark" Width="12" Height="12" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ModeHint" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </DockPanel>
                        </k:Glass>

                        <!-- ping (live heartbeat), download, upload (HomeUi.kt StatsRow) -->
                        <k:Glass Height="48" Padding="4,0" Margin="0,8,0,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{k:T 'Ping'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                                        <TextBlock x:Name="PingText" Text="--" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Poppins}" VerticalAlignment="Center"/>
                                        <TextBlock Text="ms" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource Poppins}" Foreground="{DynamicResource Muted}"
                                                   Margin="3,0,0,0" VerticalAlignment="Center"/>
                                        <k:PingPulse x:Name="PingLine" Width="44" Height="18" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Width="1" Height="28" Fill="{DynamicResource StatDivider}"/>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}">
                                            <k:KIcon Kind="down" Width="9" Height="9" Fill="{DynamicResource Accent}"/>
                                        </Border>
                                        <TextBlock Text="{k:T 'Download'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                                        <TextBlock x:Name="DownText" Text="--" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Poppins}" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="Mbps" FontSize="9.5" FontWeight="SemiBold" FontFamily="{StaticResource Poppins}" Foreground="{DynamicResource Muted}"
                                                   Margin="3,0,0,2" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                                <Rectangle Grid.Column="3" Width="1" Height="28" Fill="{DynamicResource StatDivider}"/>
                                <StackPanel Grid.Column="4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Primary}" Background="{DynamicResource PrimarySoft}">
                                            <k:KIcon Kind="up" Width="9" Height="9" Fill="{DynamicResource Primary}"/>
                                        </Border>
                                        <TextBlock Text="{k:T 'Upload'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                                        <TextBlock x:Name="UpText" Text="--" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource Poppins}" Foreground="{DynamicResource Text}"/>
                                        <TextBlock Text="Mbps" FontSize="9.5" FontWeight="SemiBold" FontFamily="{StaticResource Poppins}" Foreground="{DynamicResource Muted}"
                                                   Margin="3,0,0,2" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </k:Glass>

                        <!-- data left, days left, status; under it the data used (HomeUi.kt UsageStrip) -->
                        <Button Style="{StaticResource Plain}" Click="Account_Click" Margin="0,8,0,0">
                            <k:Glass>
                                <StackPanel>
                                    <Grid Height="34" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="DataText" FontSize="14" FontWeight="Black" Foreground="{DynamicResource Text}"/>
                                            <TextBlock Text="{k:T 'GB'}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Width="1" Height="18" Fill="{DynamicResource PrimaryFaint}"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="DaysText" FontSize="14" FontWeight="Black" Foreground="{DynamicResource Text}"/>
                                            <TextBlock Text="{k:T 'days'}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Rectangle Grid.Column="3" Width="1" Height="18" Fill="{DynamicResource PrimaryFaint}"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StatusText" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="DataBarBox" Height="4" Margin="12,0,12,8">
                                        <Border CornerRadius="2" Background="{DynamicResource WhiteFaint}"/>
                                        <Border x:Name="DataBar" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                                    </Grid>
                                </StackPanel>
                            </k:Glass>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================== Servers -->
                <ScrollViewer x:Name="ServersPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,4,16,16">
                        <Border Style="{StaticResource CardBox}" BorderBrush="{DynamicResource EdgeStrong}" Padding="14">
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png" Width="56" Height="56"
                                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="{k:T 'Kanki servers'}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="{k:T 'Fast, secure and always ready: connect with one tap'}" Style="{StaticResource Small}"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border CornerRadius="9" Padding="10,2" Margin="0,0,6,0" BorderThickness="1" BorderBrush="{DynamicResource PrimaryDark}">
                                            <TextBlock x:Name="CountriesChip" FontSize="12" Foreground="{DynamicResource Primary}"/>
                                        </Border>
                                        <Border CornerRadius="9" Padding="10,2" BorderThickness="1" BorderBrush="{DynamicResource PrimaryDark}">
                                            <TextBlock x:Name="ConfigsChip" FontSize="12" Foreground="{DynamicResource Primary}"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="PingAllBtn" DockPanel.Dock="Right" Style="{StaticResource BigButton}" MinHeight="38" Padding="22,4"
                                            Content="{k:T 'Again'}" Click="PingAll_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{k:T 'Ping all'}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock x:Name="PingAllSub" Style="{StaticResource Small}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Margin="0,10,0,0" Height="4" FlowDirection="LeftToRight">
                                    <Border CornerRadius="2" Background="{DynamicResource Surface}"/>
                                    <Border x:Name="PingAllBar" CornerRadius="2" Background="{DynamicResource NavSelected}" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ServersEmpty" Style="{StaticResource Small}" FontSize="14" Margin="4,20" Visibility="Collapsed"
                                   Text="{k:T 'No servers for Windows in this subscription yet.'}"/>
                        <StackPanel x:Name="CountryList" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================== Speed test -->
                <ScrollViewer x:Name="SpeedPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="{k:T 'Speed test'}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="SpeedWhere" Style="{StaticResource Small}"/>
                        <Border Style="{StaticResource CardBox}" Margin="0,12,0,0" Padding="14">
                            <StackPanel>
                                <UniformGrid Columns="3">
                                    <Border x:Name="ChipPing" CornerRadius="14" Padding="6,4" Margin="3" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                        <TextBlock x:Name="ChipPingText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ChipDown" CornerRadius="14" Padding="6,4" Margin="3" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                        <TextBlock x:Name="ChipDownText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ChipUp" CornerRadius="14" Padding="6,4" Margin="3" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                        <TextBlock x:Name="ChipUpText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                                <Canvas x:Name="Gauge" Width="260" Height="230" Margin="0,8,0,0" FlowDirection="LeftToRight"/>
                                <TextBlock x:Name="GaugeLabel" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Connected}" Margin="0,-10,0,8"/>
                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource CardBox}" Margin="3" Padding="12,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource Primary}"/>
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{k:T 'Download'}" Style="{StaticResource Small}" HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="SpDown" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="--"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBox}" Margin="3" Padding="12,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE898;" Foreground="{DynamicResource Primary}"/>
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{k:T 'Upload'}" Style="{StaticResource Small}" HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="SpUp" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="--"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBox}" Margin="3" Padding="12,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE9D2;" Foreground="{DynamicResource Primary}"/>
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{k:T 'Ping'}" Style="{StaticResource Small}" HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="SpPing" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="--"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBox}" Margin="3" Padding="12,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE916;" Foreground="{DynamicResource Primary}"/>
                                            <StackPanel HorizontalAlignment="Left">
                                                <TextBlock Text="{k:T 'Jitter'}" Style="{StaticResource Small}" HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="SpJitter" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left" Text="--"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock x:Name="SpLoss" Style="{StaticResource Small}" Margin="4,10,4,0"/>
                                <TextBlock Style="{StaticResource Small}" Margin="4,2,4,0"><Run Text="{k:T 'Test server:'}"/><Run Text=" Cloudflare" FontWeight="Bold"/></TextBlock>
                                <Button x:Name="SpeedBtn" Style="{StaticResource BigButton}" Content="{k:T 'Start test'}" Margin="0,14,0,0" Click="Speed_Click"/>
                                <TextBlock x:Name="SpUsed" Style="{StaticResource Small}" Margin="4,8,4,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================== Settings -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="{k:T 'Settings'}" FontSize="20" FontWeight="Bold"/>

                        <TextBlock Style="{StaticResource Section}" Text="{k:T 'Connection'}"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Button Style="{StaticResource Plain}" Click="Dns_Click">
                                    <DockPanel Margin="0,4">
                                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" Foreground="{DynamicResource Primary}"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE70D;" Foreground="{DynamicResource Primary}" FontSize="12"/>
                                        <StackPanel>
                                            <TextBlock Text="DNS" FontWeight="Bold"/>
                                            <TextBlock x:Name="DnsSub" Style="{StaticResource Small}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <StackPanel x:Name="DnsChoices" Visibility="Collapsed" Margin="8,4,8,8"/>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,4"/>
                                <CheckBox x:Name="AutoBox" Style="{StaticResource Switch}" Click="Setting_Changed">
                                    <StackPanel>
                                        <TextBlock Text="{k:T 'Auto connect'}" FontWeight="Bold"/>
                                        <TextBlock Text="{k:T 'Connects by itself when Windows starts'}" Style="{StaticResource Small}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,4"/>
                                <CheckBox x:Name="KillBox" Style="{StaticResource Switch}" Click="Setting_Changed">
                                    <StackPanel>
                                        <TextBlock Text="{k:T 'Kill switch and always-on'}" FontWeight="Bold"/>
                                        <TextBlock Text="{k:T 'If the VPN drops, all internet stops until it is back'}" Style="{StaticResource Small}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,4"/>
                                <CheckBox x:Name="Ipv6Box" Style="{StaticResource Switch}" Click="Setting_Changed">
                                    <StackPanel>
                                        <TextBlock Text="{k:T 'Block IPv6 outside the VPN'}" FontWeight="Bold"/>
                                        <TextBlock Text="{k:T 'DNS and IPv6 never leak outside the tunnel'}" Style="{StaticResource Small}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,4"/>
                                <CheckBox x:Name="LanBox" Style="{StaticResource Switch}" Click="Setting_Changed">
                                    <StackPanel>
                                        <TextBlock Text="{k:T 'Allow local network'}" FontWeight="Bold"/>
                                        <TextBlock Text="{k:T 'Printers, file sharing and the router stay reachable'}" Style="{StaticResource Small}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,4"/>
                                <Button Style="{StaticResource Plain}" Click="Split_Click">
                                    <DockPanel Margin="0,4">
                                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Foreground="{DynamicResource Primary}"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE70D;" Foreground="{DynamicResource Primary}" FontSize="12"/>
                                        <StackPanel>
                                            <TextBlock Text="{k:T 'Split tunneling'}" FontWeight="Bold"/>
                                            <TextBlock x:Name="SplitSub" Style="{StaticResource Small}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <StackPanel x:Name="SplitPanel" Visibility="Collapsed" Margin="8,4,8,8">
                                    <RadioButton x:Name="SplitAll" Style="{StaticResource Choice}" GroupName="split" Content="{k:T 'Everything through the VPN'}" Click="Setting_Changed"/>
                                    <RadioButton x:Name="SplitExclude" Style="{StaticResource Choice}" GroupName="split" Content="{k:T 'Everything except these addresses'}" Click="Setting_Changed"/>
                                    <RadioButton x:Name="SplitInclude" Style="{StaticResource Choice}" GroupName="split" Content="{k:T 'Only these addresses'}" Click="Setting_Changed"/>
                                    <TextBox x:Name="SplitBox" FlowDirection="LeftToRight" AcceptsReturn="True" MinHeight="88" Margin="0,6,0,0"
                                             VerticalContentAlignment="Top" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" LostFocus="Setting_Changed"/>
                                    <TextBlock Style="{StaticResource Small}" Text="{k:T 'One IP or range per line, like 5.0.0.0/8'}"/>
                                    <TextBlock x:Name="SplitNote" Style="{StaticResource Small}" Foreground="{DynamicResource Warn}"
                                               Text="{k:T 'The kill switch does not apply when only some addresses use the VPN.'}"/>
                                </StackPanel>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,4"/>
                                <DockPanel Margin="0,4">
                                    <TextBox x:Name="MtuBox" DockPanel.Dock="Right" Width="90" FlowDirection="LeftToRight" LostFocus="Setting_Changed"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MTU" FontWeight="Bold"/>
                                        <TextBlock Text="{k:T '0 = automatic'}" Style="{StaticResource Small}"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="SaveMsg" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{k:T 'Look and language'}"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel Margin="0,4">
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Foreground="{DynamicResource Primary}"/>
                                    </Border>
                                    <TextBlock Text="{k:T 'App theme'}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <UniformGrid x:Name="ThemeCards" Columns="2" Margin="0,8,0,4"/>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,8"/>
                                <DockPanel Margin="0,2">
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{DynamicResource Primary}"/>
                                    </Border>
                                    <Border DockPanel.Dock="Right" CornerRadius="16" Padding="3" BorderThickness="1" BorderBrush="{DynamicResource Edge}" FlowDirection="LeftToRight">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="lang" Content="English" Click="Lang_Click"/>
                                            <RadioButton x:Name="LangFa" Style="{StaticResource Segment}" GroupName="lang" Content="فارسی" Click="Lang_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{k:T 'Language'}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,8"/>
                                <CheckBox x:Name="SignInBox" Style="{StaticResource Switch}" Click="SignIn_Click">
                                    <StackPanel>
                                        <TextBlock Text="{k:T 'Open at sign-in'}" FontWeight="Bold"/>
                                        <TextBlock Text="{k:T 'Kanki VPN waits next to the clock'}" Style="{StaticResource Small}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="{k:T 'Account and support'}"/>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Button Style="{StaticResource Plain}" Click="Account_Click">
                                    <DockPanel Margin="0,4">
                                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Foreground="{DynamicResource Primary}"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76B;" Foreground="{DynamicResource Primary}" FontSize="12"/>
                                        <StackPanel>
                                            <TextBlock Text="{k:T 'Account'}" FontWeight="Bold"/>
                                            <TextBlock x:Name="AccountSub" Style="{StaticResource Small}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,4"/>
                                <Button Style="{StaticResource Plain}" Click="Renew_Click">
                                    <DockPanel Margin="0,4">
                                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BF;" Foreground="{DynamicResource Primary}"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76B;" Foreground="{DynamicResource Primary}" FontSize="12"/>
                                        <StackPanel>
                                            <TextBlock Text="{k:T 'Buy and renew'}" FontWeight="Bold"/>
                                            <TextBlock Text="{k:T 'Through the Telegram bot'}" Style="{StaticResource Small}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <Rectangle Height="1" Fill="{DynamicResource Edge}" Margin="0,4"/>
                                <Button Style="{StaticResource Plain}" Click="Log_Click">
                                    <DockPanel Margin="0,4">
                                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" Background="{DynamicResource Surface}" BorderThickness="1" BorderBrush="{DynamicResource Edge}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" Foreground="{DynamicResource Primary}"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76B;" Foreground="{DynamicResource Primary}" FontSize="12"/>
                                        <StackPanel>
                                            <TextBlock Text="{k:T 'Connection log'}" FontWeight="Bold"/>
                                            <TextBlock Text="{k:T 'What the VPN service did, for support'}" Style="{StaticResource Small}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <StackPanel x:Name="LogPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                    <TextBox x:Name="LogBox" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="11"
                                             TextWrapping="Wrap" VerticalContentAlignment="Top" Height="220" VerticalScrollBarVisibility="Auto"/>
                                    <Button Style="{StaticResource Outline}" Content="{k:T 'Copy log'}" Margin="0,8,0,0" Click="CopyLog_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Small}" Margin="4,16,4,0" FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================== account sheet (over Home, like Android) -->
                <Grid x:Name="AccountSheet" Visibility="Collapsed" Panel.ZIndex="10" Background="#B3000000">
                    <Border Style="{StaticResource CardBox}" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource EdgeStrong}"
                            VerticalAlignment="Center" Margin="16,0" Padding="18">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Margin="0,0,10,0" Background="{DynamicResource Surface}" BorderThickness="1.2" BorderBrush="{DynamicResource Primary}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Foreground="{DynamicResource Primary}"/>
                                </Border>
                                <Border x:Name="AccStatusPill" DockPanel.Dock="Right" CornerRadius="10" Padding="10,2" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Connected}">
                                    <TextBlock x:Name="AccStatus" FontSize="12" Foreground="{DynamicResource Connected}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="AccUser" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{k:T 'Account details'}" Style="{StaticResource Small}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{k:T 'Data remaining'}" Style="{StaticResource Small}" FontSize="13"/>
                                <TextBlock x:Name="AccLeft" Grid.Column="1" FontWeight="Bold" FlowDirection="LeftToRight"/>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="5" Margin="0,6,0,10" FlowDirection="LeftToRight">
                                    <Border CornerRadius="3" Background="{DynamicResource Surface}"/>
                                    <Border x:Name="AccBar" CornerRadius="3" Background="{DynamicResource Connected}" HorizontalAlignment="Right" Width="0"/>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="{k:T 'Used'}" Style="{StaticResource Small}" FontSize="13" Margin="0,4"/>
                                <TextBlock x:Name="AccUsed" Grid.Row="2" Grid.Column="1" FontWeight="Bold" FlowDirection="LeftToRight" Margin="0,4"/>
                                <TextBlock Grid.Row="3" Text="{k:T 'Time remaining'}" Style="{StaticResource Small}" FontSize="13" Margin="0,4"/>
                                <TextBlock x:Name="AccTime" Grid.Row="3" Grid.Column="1" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="4" Text="{k:T 'Expires'}" Style="{StaticResource Small}" FontSize="13" Margin="0,4"/>
                                <TextBlock x:Name="AccExpiry" Grid.Row="4" Grid.Column="1" FontWeight="Bold" Margin="0,4"/>
                                <TextBlock Grid.Row="5" Text="{k:T 'Connections at once'}" Style="{StaticResource Small}" FontSize="13" Margin="0,4"/>
                                <TextBlock x:Name="AccConn" Grid.Row="5" Grid.Column="1" FontWeight="Bold" Margin="0,4"/>
                            </Grid>
                            <Button Style="{StaticResource BigButton}" Content="{k:T 'Renew service'}" Margin="0,16,0,0" Click="Renew_Click"/>
                            <UniformGrid Columns="3" Margin="-4,8,-4,0">
                                <Button Style="{StaticResource Outline}" Content="{k:T 'Refresh'}" Margin="4,0" Padding="6,4" Click="Refresh_Click"/>
                                <Button Style="{StaticResource Outline}" Content="{k:T 'Copy sub link'}" Margin="4,0" Padding="6,4" Click="CopySub_Click"/>
                                <Button Style="{StaticResource Outline}" Content="{k:T 'Support'}" Margin="4,0" Padding="6,4" Click="Renew_Click"/>
                            </UniformGrid>
                            <TextBlock x:Name="AccMsg" Style="{StaticResource Small}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <Button Style="{StaticResource Plain}" Click="SignOut_Click" MinHeight="36">
                                    <TextBlock Text="{k:T 'Sign out'}" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource Plain}" Click="CloseSheet_Click" MinHeight="36">
                                    <TextBlock Text="{k:T 'Close'}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- bottom bar (HomeUi.kt BottomBar): glass bar, the chosen tab filled with the theme's gradient -->
            <k:Glass x:Name="NavBar" Grid.Row="2" Margin="12,8,12,8" CornerRadius="20" Padding="4">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="TabHome" Style="{StaticResource NavTab}" IsChecked="True" Checked="Tab_Checked">
                        <StackPanel>
                            <k:KIcon Kind="home" Width="20" Height="20" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="{k:T 'Home'}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabServers" Style="{StaticResource NavTab}" Checked="Tab_Checked">
                        <StackPanel>
                            <k:KIcon Kind="globe" Width="20" Height="20" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="{k:T 'Servers'}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabSpeed" Style="{StaticResource NavTab}" Checked="Tab_Checked">
                        <StackPanel>
                            <k:KIcon Kind="gauge" Width="20" Height="20" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="{k:T 'Speed test'}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabSettings" Style="{StaticResource NavTab}" Checked="Tab_Checked">
                        <StackPanel>
                            <k:KIcon Kind="sliders" Width="20" Height="20" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="{k:T 'Settings'}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </k:Glass>
        </Grid>
    </Grid>
</Window>
