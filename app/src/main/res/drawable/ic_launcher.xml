<?xml version="1.0" encoding="utf-8"?>
<!-- آیکون برنامه (Adaptive Icon، ۱.۳۴.۱): زمینه‌ی جدا (تیره‌ی دودی متالیک، وکتور) + جلو (حلقه‌ی شیشه‌ای و K سبز نئونی، بی‌زمینه،
     داخل ناحیه‌ی امن ۶۶dp تا هیچ شکل لانچری آن را نبرد) + تک‌رنگ برای آیکون‌های هم‌رنگ اندروید ۱۳ -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg" />
    <foreground android:drawable="@drawable/ic_launcher_fg" />
    <monochrome android:drawable="@drawable/ic_launcher_mono" />
</adaptive-icon>
