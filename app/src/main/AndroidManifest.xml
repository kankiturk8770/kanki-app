<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- KPING: دیتای موبایل کنار وای‌فای روشن بماند (requestNetwork) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-openvpn-profile" />
        </intent>
        <!-- گره‌زدن به نام بسته‌های گوگل (gms، پلی‌استور، …) برداشته شد: اسکنرها (Play Protect) این الگو را
             مشکوک می‌شمارند. «فقط بازی» به آن‌ها نیاز ندارد؛ خود بازی از راه پرس‌وجوی لانچر بالا پیدا و باز می‌شود.
             باز کردن لینک (ربات/پشتیبانی) هم با startActivity است و به پرس‌وجو نیاز ندارد. -->
        <package android:name="net.openvpn.openvpn" />
        <package android:name="de.blinkt.openvpn" />
    </queries>

    <application
        android:name=".KankiApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- آیکون برنامه به رنگ تم (۱.۲۹): هر تم یک alias با آیکون خودش؛ فقط یکی روشن است (LauncherIcon). طلایی و طلای فلزی: Icon_gold -->
        <activity-alias
            android:name=".Icon_gold"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@drawable/ic_launcher"
            android:roundIcon="@drawable/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_yellow"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher_yellow"
            android:roundIcon="@drawable/ic_launcher_yellow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_crimson"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher_crimson"
            android:roundIcon="@drawable/ic_launcher_crimson">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_purple"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher_purple"
            android:roundIcon="@drawable/ic_launcher_purple">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_lime"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher_lime"
            android:roundIcon="@drawable/ic_launcher_lime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_sapphire"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher_sapphire"
            android:roundIcon="@drawable/ic_launcher_sapphire">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_turquoise"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher_turquoise"
            android:roundIcon="@drawable/ic_launcher_turquoise">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_amethyst"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher_amethyst"
            android:roundIcon="@drawable/ic_launcher_amethyst">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- سرویس VPN امنزیا (AbstractBackend$VpnService) را خود کتابخانه در مانیفستش دارد.
             کلاس GoBackend$VpnService در نسخه‌ی 2.3.7 وجود ندارد و نباید این‌جا تعریف شود. -->
        <!-- اتصال Hysteria2 (هسته‌ی hysteria + tun2socks) -->
        <service
            android:name="cafe.kankipro.vpn.KankiHyService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <provider
            android:name="cafe.kankipro.vpn.KankiFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name="cafe.kankipro.vpn.KankiTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Kanki VPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="cafe.kankipro.vpn.KankiActionReceiver"
            android:exported="false" />
    </application>
</manifest>
