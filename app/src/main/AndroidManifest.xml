<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- KPING: دیتای موبایل کنار وای‌فای روشن بماند (requestNetwork) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- فقط پرس‌وجوی لانچر (پیدا کردن بازی‌ها برای «فقط بازی» و تونل انتخابی). نام بسته‌ی هیچ برنامه‌ی دیگری (گوگل، OpenVPN)
             این‌جا نیست: اسکنرها (Play Protect) این الگو را مشکوک می‌شمارند. -->
    </queries>

    <application
        android:name=".KankiApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- تنها ورودی لانچر، با یک آیکون ثابت (۱.۳۳.۴): ورودی‌های آیکون جدا (activity-alias) و روشن/خاموش کردنشان در اجرا حذف شد؛
             رنگ تم فقط لوگوی داخل خود برنامه را عوض می‌کند -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- سرویس VPN امنزیا (AbstractBackend$VpnService) را خود کتابخانه در مانیفستش دارد.
             کلاس GoBackend$VpnService در نسخه‌ی 2.3.7 وجود ندارد و نباید این‌جا تعریف شود. -->
        <!-- اتصال Hysteria2 (هسته‌ی hysteria + tun2socks) -->
        <service
            android:name="cafe.kankipro.vpn.KankiHyService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <provider
            android:name="cafe.kankipro.vpn.KankiFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <service
            android:name="cafe.kankipro.vpn.KankiTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Kanki VPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="cafe.kankipro.vpn.KankiActionReceiver"
            android:exported="false" />
    </application>
</manifest>
