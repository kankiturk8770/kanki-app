# --- اندروید استودیو و گریدل
*.iml
.gradle/
.idea/
local.properties
build/
captures/
.externalNativeBuild/
.cxx/
.DS_Store

# --- کلید امضا و رمزها: هرگز داخل مخزن نرود
*.jks
*.keystore
*.b64
keystore.properties

# --- فایل‌هایی که هنگام ساخت خودکار دانلود می‌شوند (فونت‌ها و نقشه)
app/src/main/res/font/*
# Vazirmatn (the Persian font) is kept in the repository, so a build never falls back to the system font
!app/src/main/res/font/vazir_*.ttf
app/src/main/assets/countries.geojson

# ساخته‌شده در build.yml (هسته‌ی KANKI MIX)
app/src/main/jniLibs/*/libkmix.so
# --- نسخه‌ی ویندوز
windows/ui/**/bin/
windows/ui/**/obj/
windows/dist/
dist/
publish/
shots/
